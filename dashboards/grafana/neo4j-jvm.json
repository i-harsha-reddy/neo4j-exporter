{
  "uid": "neo4j-jvm",
  "title": "Neo4j — JVM",
  "description": "JVM heap, non-heap, GC, threads, classes, CPU, FDs (via Jolokia / java.lang:* MBeans).",
  "tags": ["neo4j", "jvm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "templating": {
    "list": [
      {"name": "datasource", "type": "datasource", "query": "prometheus",
       "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"}},
      {"name": "instance", "type": "query",
       "datasource": {"type": "prometheus", "uid": "${datasource}"},
       "query": "label_values(neo4j_up, instance)",
       "multi": true, "includeAll": true,
       "current": {"selected": true, "text": "All", "value": "$__all"},
       "refresh": 2, "sort": 1}
    ]
  },
  "panels": [
    {"type": "row", "title": "Headline", "id": 100,
     "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "collapsed": false},
    {"id": 1, "type": "stat", "title": "Heap used",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
     "targets": [{"refId": "A", "expr": "sum(neo4j_jvm_heap_used_bytes{instance=~\"$instance\"})"}],
     "fieldConfig": {"defaults": {"unit": "bytes"}},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 2, "type": "stat", "title": "Heap %",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
     "targets": [{"refId": "A", "expr": "max((neo4j_jvm_heap_used_bytes{instance=~\"$instance\"} / neo4j_jvm_heap_max_bytes{instance=~\"$instance\"}))"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1,
       "thresholds": {"mode": "absolute", "steps": [
         {"color": "green", "value": null}, {"color": "yellow", "value": 0.75}, {"color": "red", "value": 0.9}]}}},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 3, "type": "stat", "title": "GC time ratio (5m)",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
     "targets": [{"refId": "A", "expr": "max(sum by (instance) (rate(neo4j_jvm_gc_seconds_total{instance=~\"$instance\"}[5m])))"}],
     "fieldConfig": {"defaults": {"unit": "percentunit",
       "thresholds": {"mode": "absolute", "steps": [
         {"color": "green", "value": null}, {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.2}]}}},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 4, "type": "stat", "title": "Threads",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
     "targets": [{"refId": "A", "expr": "sum(neo4j_jvm_threads_current{instance=~\"$instance\"})"}],
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 5, "type": "stat", "title": "Open FD ratio",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
     "targets": [{"refId": "A", "expr": "max((neo4j_jvm_open_fds{instance=~\"$instance\"} / clamp_min(neo4j_jvm_max_fds{instance=~\"$instance\"}, 1)))"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1,
       "thresholds": {"mode": "absolute", "steps": [
         {"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.85}]}}},
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 6, "type": "stat", "title": "Uptime",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
     "targets": [{"refId": "A", "expr": "max(neo4j_jvm_uptime_seconds{instance=~\"$instance\"})"}],
     "fieldConfig": {"defaults": {"unit": "s"}},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},

    {"type": "row", "title": "Heap & non-heap", "id": 101,
     "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "collapsed": false},
    {"id": 7, "type": "timeseries", "title": "Heap: used / committed / max",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
     "targets": [
       {"refId": "A", "expr": "neo4j_jvm_heap_used_bytes{instance=~\"$instance\"}", "legendFormat": "used {{instance}}"},
       {"refId": "B", "expr": "neo4j_jvm_heap_committed_bytes{instance=~\"$instance\"}", "legendFormat": "committed {{instance}}"},
       {"refId": "C", "expr": "neo4j_jvm_heap_max_bytes{instance=~\"$instance\"}", "legendFormat": "max {{instance}}"}
     ],
     "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 8, "type": "timeseries", "title": "Non-heap: used / committed / max",
     "description": "max may be omitted (=-1 in JMX); ratio panels use clamp_min for safety.",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
     "targets": [
       {"refId": "A", "expr": "neo4j_jvm_nonheap_used_bytes{instance=~\"$instance\"}", "legendFormat": "used {{instance}}"},
       {"refId": "B", "expr": "neo4j_jvm_nonheap_committed_bytes{instance=~\"$instance\"}", "legendFormat": "committed {{instance}}"},
       {"refId": "C", "expr": "neo4j_jvm_nonheap_max_bytes{instance=~\"$instance\"}", "legendFormat": "max {{instance}}"}
     ],
     "fieldConfig": {"defaults": {"unit": "bytes"}}},

    {"type": "row", "title": "GC", "id": 102,
     "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15}, "collapsed": false},
    {"id": 9, "type": "timeseries", "title": "GC time per collector (rate)",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
     "targets": [{"refId": "A", "expr": "rate(neo4j_jvm_gc_seconds_total{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "{{instance}} {{gc}}"}],
     "fieldConfig": {"defaults": {"unit": "percentunit"}}},
    {"id": 10, "type": "timeseries", "title": "GC counts per collector (rate /s)",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
     "targets": [{"refId": "A", "expr": "rate(neo4j_jvm_gc_count_total{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "{{instance}} {{gc}}"}]},
    {"id": 11, "type": "timeseries", "title": "GC pause per cycle (estimate)",
     "description": "rate(seconds_total) / rate(count_total). Spikes >0.5s indicate full GCs.",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
     "targets": [{"refId": "A", "expr": "rate(neo4j_jvm_gc_seconds_total{instance=~\"$instance\"}[$__rate_interval]) / clamp_min(rate(neo4j_jvm_gc_count_total{instance=~\"$instance\"}[$__rate_interval]), 0.001)", "legendFormat": "{{instance}} {{gc}}"}],
     "fieldConfig": {"defaults": {"unit": "s",
       "thresholds": {"mode": "absolute", "steps": [
         {"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "red", "value": 0.5}]}}}},

    {"type": "row", "title": "Threads & classes", "id": 103,
     "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24}, "collapsed": false},
    {"id": 12, "type": "timeseries", "title": "Threads (current / daemon / peak)",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 25},
     "targets": [
       {"refId": "A", "expr": "neo4j_jvm_threads_current{instance=~\"$instance\"}", "legendFormat": "current {{instance}}"},
       {"refId": "B", "expr": "neo4j_jvm_threads_daemon{instance=~\"$instance\"}", "legendFormat": "daemon {{instance}}"},
       {"refId": "C", "expr": "neo4j_jvm_threads_peak{instance=~\"$instance\"}", "legendFormat": "peak {{instance}}"}
     ]},
    {"id": 13, "type": "timeseries", "title": "Classes loaded / unloaded",
     "description": "Loaded count + load/unload rates. Sustained high unload-rate suggests classloader churn or memory leak.",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 25},
     "targets": [
       {"refId": "A", "expr": "neo4j_jvm_classes_loaded{instance=~\"$instance\"}", "legendFormat": "loaded (current) {{instance}}"},
       {"refId": "B", "expr": "rate(neo4j_jvm_classes_loaded_total{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "load rate /s {{instance}}"},
       {"refId": "C", "expr": "rate(neo4j_jvm_classes_unloaded_total{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "unload rate /s {{instance}}"}
     ]},

    {"type": "row", "title": "CPU & FDs", "id": 104,
     "gridPos": {"h": 1, "w": 24, "x": 0, "y": 33}, "collapsed": false},
    {"id": 14, "type": "timeseries", "title": "CPU load (process / system / load1m)",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 34},
     "targets": [
       {"refId": "A", "expr": "neo4j_jvm_cpu_process_ratio{instance=~\"$instance\"}", "legendFormat": "process {{instance}}"},
       {"refId": "B", "expr": "neo4j_jvm_cpu_system_ratio{instance=~\"$instance\"}", "legendFormat": "system {{instance}}"},
       {"refId": "C", "expr": "neo4j_jvm_load_average_1m{instance=~\"$instance\"}", "legendFormat": "load1m {{instance}}"}
     ],
     "fieldConfig": {"defaults": {"unit": "percentunit"}}},
    {"id": 15, "type": "timeseries", "title": "File descriptors (open / max)",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 34},
     "targets": [
       {"refId": "A", "expr": "neo4j_jvm_open_fds{instance=~\"$instance\"}", "legendFormat": "open {{instance}}"},
       {"refId": "B", "expr": "neo4j_jvm_max_fds{instance=~\"$instance\"}", "legendFormat": "max {{instance}}"}
     ]},

    {"type": "row", "title": "Identity & lifecycle", "id": 105,
     "gridPos": {"h": 1, "w": 24, "x": 0, "y": 42}, "collapsed": false},
    {"id": 16, "type": "stat", "title": "JVM started",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 6, "w": 12, "x": 0, "y": 43},
     "targets": [{"refId": "A", "expr": "neo4j_jvm_start_timestamp_seconds{instance=~\"$instance\"} * 1000", "legendFormat": "{{instance}}"}],
     "fieldConfig": {"defaults": {"unit": "dateTimeFromNow"}},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 17, "type": "timeseries", "title": "Threads started rate (leak hint)",
     "description": "Sustained high rate suggests a thread leak.",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "gridPos": {"h": 6, "w": 12, "x": 12, "y": 43},
     "targets": [{"refId": "A", "expr": "rate(neo4j_jvm_threads_started_total{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "{{instance}}"}]}
  ]
}
